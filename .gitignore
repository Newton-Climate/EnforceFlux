*.png
# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Output and run directories at the repo root (not the enforceflux.runs
# package or tests/runs test module — those live under src/ and tests/).
/outputs/
/runs/
/analysis/
/data/

# macOS
.DS_Store

# Test cache and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Vendored upstream clones — nested git repos recreated by their make targets,
# never tracked here (see: make install-flexpart, make install-microhh)
/flexpart/
/microhh/

# FLEXPART build artifacts (redundant while /flexpart/ is ignored wholesale;
# kept so the rules survive if that directory is ever tracked again)
flexpart/src/*.o
flexpart/src/*.mod
flexpart/src/FLEXPART
flexpart/src/FLEXPART_ETA
flexpart/tests/testdata/
flexpart/tests/__pycache__/

# Vendored AtmosTransport.jl clone (a nested git repo, like /microhh/)
/AtmosTransport.jl/

# Slide-generation tooling
node_modules/

# Documents and generated decks — reference papers, exported presentations.
# Nothing of these types is tracked; narrow these if a doc should be versioned.
*.pdf
*.pptx
*.docx
*.pptx.inspect.ndjson

# Editor and agent scratch
.idea/
.vscode/
.codex/

# Large binary and data formats. Model output, met files and archives belong
# in runs/, data/ or on scratch, not in git — the analysis scripts regenerate
# every one of them from those. Four small .npz tables under
# notebooks/hetero_experiments/ predate this rule and stay tracked; add a new
# one with `git add -f` only if it is small and cannot be regenerated.
*.nc
*.nc4
*.h5
*.hdf5
*.zarr/
*.grib
*.grib2
*.grb
*.npy
*.npz
*.pkl
*.pickle
*.mat
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.jpg
*.jpeg
*.tif
*.tiff
*.mp4
*.mov
*.webm
*.so
*.a
*.o
*.mod

# Presentation build scratch (rendered decks and their staging directories)
.codex-presentation-build/
